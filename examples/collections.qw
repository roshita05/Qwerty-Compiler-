keep original = [3, 1, 2];
keep updated = pushit(original, 4);
sayit("Original is unchanged:", original);
sayit("Updated:", sortit(updated));
updated = putit(updated, 0, 99);
sayit("Replacement:", updated);
keep profile = mapit(["language"], ["QWERTY"]);
profile = setit(profile, "functions", 80);
each key over keysit(profile) {
    sayit(key, getit(profile, key));
}
