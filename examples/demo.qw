# QWERTY: independent syntax, custom names, Python implementation.
sayit("Welcome to QWERTY!");
keep a = 20;
keep b = 5;
sayit("Addition:", addit(a, b));
sayit("Subtraction:", subit(a, b));
sayit("Multiplication:", multit(a, b));
sayit("Division:", divit(a, b));

keep marks = [78, 92, 85, 92, 66];
sayit("Average:", avgit(marks));
sayit("Unique, sorted:", sortit(uniqueit(marks)));

when greaterit(avgit(marks), 80) {
    sayit("Result: excellent");
} otherwise {
    sayit("Result: keep learning");
}

craft factorialq(n) {
    when n <= 1 {
        give 1;
    }
    give multit(n, factorialq(subit(n, 1)));
}
sayit("Factorial of 5:", factorialq(5));

each n over spanit(1, 4) {
    sayit("Square:", n, powerit(n, 2));
}

keep person = mapit(["name", "language"], ["Ada", "QWERTY"]);
sayit(concatit("Hello, ", upperit(getit(person, "name")), "!"));
assertit(equalit(addit(2, 3), 5), "Arithmetic check failed");
